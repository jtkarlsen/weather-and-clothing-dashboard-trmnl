<div class="layout">
  {% if ok %}
  <div class="kc">
    <header class="kc-hd">
      <h1>Hva skal jeg ha på meg {{ day_label | downcase }}?</h1>
      <div class="kc-date">{{ date }}<span>{{ place }} · oppdatert {{ updated }}</span></div>
    </header>

    <div class="kc-main">
      <section class="kc-wx">
        {% for p in periods %}
        <div class="kc-pc">
          <div class="kc-pc-hd"><b>{{ p.label }}</b><small>kl. {{ p.range }}</small></div>
          <div class="kc-pc-main">
            <svg><use href="#kc-w-{{ p.icon }}"/></svg>
            <div class="kc-pc-t">{{ p.temp }}</div>
          </div>
          <p class="kc-pc-say">{{ p.say }}</p>
        </div>
        {% endfor %}
        <div class="kc-hours">
          <h2>Time for time <span class="kc-unit">nedbør i mm</span></h2>
          <div class="kc-strip">
            {% for h in strip %}
            <div class="kc-hr">
              <span class="kc-h">{{ h.hour }}</span>
              <span class="kc-c">{{ h.temp }}</span>
              <span class="kc-box"><span class="kc-bar" style="height: {{ h.bar }}%"></span></span>
              <span class="kc-mm">{{ h.precip }}</span>
              <span class="kc-lt{% if h.dark %} dark{% endif %}"></span>
            </div>
            {% endfor %}
          </div>
          <div class="kc-sun"><span><i class="dark"></i>Mørkt</span><span><i></i>Lyst</span><span>{{ sun }}</span></div>
        </div>
      </section>

      <section class="kc-fit">
        <div class="kc-split-hd">
          <h2 class="kc-sub">Ha på deg</h2>
          <h2 class="kc-sub kc-bag-hd"><svg><use href="#kc-sekk"/></svg>I sekken</h2>
        </div>
        {% assign on_items = items | where: "status", "on" %}
        {% assign cols = on_items.size | plus: 1 | divided_by: 2 %}
        <div class="kc-split">
          <div class="kc-flex kc-cols-{{ cols }}">
            {% for it in on_items %}
            <div class="kc-card"><svg><use href="#kc-{{ it.icon }}"/></svg><h3>{{ it.name }}</h3></div>
            {% endfor %}
          </div>
          <div class="kc-bagbox">
            {% for it in items %}{% if it.status == "bag" %}
            <div class="kc-bagitem"><svg><use href="#kc-{{ it.icon }}"/></svg><span>{{ it.name }}</span></div>
            {% endif %}{% endfor %}
          </div>
        </div>
      </section>
    </div>

    {% if has_calendar and events.size > 0 %}
    <div class="kc-calbar">
      <b class="kc-calbar-hd">{{ day_label }}</b>
      {% for e in events %}
      <div class="kc-ev"><small>{{ e.time }}</small><span>{{ e.title }}</span></div>
      {% endfor %}
      {% if more_events > 0 %}<small class="kc-more">+ {{ more_events }}</small>{% endif %}
    </div>
    {% else %}
    <div class="kc-tip"><svg><use href="#kc-varsel"/></svg>{{ tip }}</div>
    {% endif %}
  </div>
  {% else %}
  <div class="kc"><p class="kc-err">{{ error | default: "Fant ingen værdata fra yr.no." }}</p></div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Klær etter været</span>
  <span class="instance">Værdata fra Yr / MET Norway</span>
</div>
